# StoryForge Studio — Environment Configuration (Example)
# DO NOT COMMIT REAL SECRETS OR .env FILES

# Backend Sidecar Network Binding
STORYFORGE_HOST=127.0.0.1
STORYFORGE_PORT=8000
STORYFORGE_TOKEN=dev-session-token-fallback

# Storage & Runtime Paths
STORYFORGE_RUNTIME_FILE=runtime.json

# Optional Cloud Providers (Disabled by default in local-first mode)
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
